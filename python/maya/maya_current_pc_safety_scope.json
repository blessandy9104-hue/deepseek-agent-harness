{
  "status": "strict_zero_interference_priority",
  "approved_by": "Andy",
  "effective_at": "2026-08-23T00:00:00+04:00",
  "operating_rule": "Do not run any task that can cause instability or reduce PC responsiveness.",
  "allowed_work": [
    "short deterministic local tests",
    "temporary local fixtures",
    "small public or synthetic evaluation data",
    "local documentation and report generation",
    "review-only UI and audit metadata",
    "disabled-by-default voice routing preparation"
  ],
  "execution_limits": {
    "run_when_user_is_not_actively_using_the_pc": true,
    "max_concurrent_maya_jobs": 1,
    "max_cpu_percent": 60.0,
    "max_memory_percent": 70.0,
    "max_maya_process_count": 2,
    "max_launches_per_minute": 1,
    "timeout_required": true,
    "stop_on_resource_warning": true,
    "stop_on_wsl2_stall": true,
    "no_continuous_background_loops": true
  },
  "deferred_until_better_hardware": [
    "large or sustained Ollama generation",
    "large-scale or concurrent historical simulations",
    "continuous presence, microphone, or screen observation",
    "unrestricted browsing or background network loops",
    "autonomous desktop application control",
    "brightness, cooling, power, process, or device control",
    "driver, service, startup-hook, or administrator-level changes"
  ],
  "preserved_safeguards": [
    "human approval",
    "privacy and approved-memory boundaries",
    "mission-integrity wall",
    "security wall",
    "system-preservation wall",
    "emergency stop",
    "audit log and rollback"
  ],
  "automatic_activation": false
}
